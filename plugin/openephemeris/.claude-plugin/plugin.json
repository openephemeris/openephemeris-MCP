{
  "name": "openephemeris",
  "version": "4.14.0",
  "description": "Sub-arcsecond planetary positions from NASA JPL DE440. Natal charts, transits, synastry, moon phases, eclipses, Human Design, and Chinese/Vedic astrology.",
  "author": {
    "name": "Spirit River Inc",
    "url": "https://openephemeris.com"
  },
  "repository": "https://github.com/openephemeris/openephemeris-MCP",
  "license": "MIT",
  "homepage": "https://openephemeris.com",
  "privacy_policies": [
    "https://openephemeris.com/privacy"
  ],
  "keywords": [
    "astrology",
    "ephemeris",
    "natal-chart",
    "transits",
    "moon-phase",
    "eclipse",
    "synastry",
    "human-design",
    "chinese-astrology",
    "vedic-astrology"
  ],
  "mcpServers": {
    "openephemeris": {
      "command": "npx",
      "args": ["-y", "@openephemeris/mcp-server"],
      "env": {
        "OPENEPHEMERIS_API_KEY": "${OPENEPHEMERIS_API_KEY}"
      }
    }
  }
}
